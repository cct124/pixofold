{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口允许有界任务查询/订阅、受控原生选择、任务接纳及任务绑定预览/定位；不授权任意路径或通用dialog/fs/event/opener操作。",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-log-status",
    "allow-open-log-directory",
    "allow-get-task-thumbnail",
    "allow-reveal-task-file",
    "allow-get-output-directories",
    "allow-open-output-directory",
    "allow-get-task-snapshot",
    "allow-subscribe-task-changes",
    "allow-acknowledge-task-changes",
    "allow-unsubscribe-task-changes",
    "allow-select-native-import",
    "allow-select-output-directory",
    "allow-release-output-directory",
    "allow-release-native-drop",
    "allow-apply-task-mutation",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
