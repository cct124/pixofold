{
  "name": "pixofold",
  "version": "0.1.0",
  "private": true,
  "description": "PixoFold（轻图）本地批量图片压缩工具",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26.9.0 <27",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tools vite.config.ts vitest.config.ts",
    "format": "prettier --write src tools *.json *.ts .github .oxlintrc.json && cargo fmt --all",
    "format:check": "prettier --check src tools *.json *.ts .github .oxlintrc.json && cargo fmt --all -- --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:generate": "node tools/generate-bindings.mjs",
    "types:check": "node tools/generate-bindings.mjs --check",
    "rust:check": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "rust:test": "cargo test --workspace --all-features --locked",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm types:check && pnpm rust:check && pnpm rust:test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
